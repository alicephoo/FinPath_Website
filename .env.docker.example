# FinPath Docker Compose environment example.
#
# Copy this file to `.env` in the project root, replace every placeholder with
# a unique local value, then run `docker compose up --build`.
#
# Use URL-safe password characters (for example hex or alphanumeric values)
# because the passwords are embedded in the database URLs below.
#
# Do not commit the real `.env` file. These values are for the local Docker
# stack only and are separate from `backend/.env`, which is used by the
# Homebrew/local PostgreSQL development setup.

# PostgreSQL superuser used only to initialize the Docker database.
POSTGRES_DB=finpath
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-superuser-password

# Password for the least-privilege runtime identity.
FINPATH_DB_PASSWORD=replace-with-a-long-random-runtime-password

# Password for the migration/seed identity that owns the Docker database.
FINPATH_MIGRATION_DB_PASSWORD=replace-with-a-long-random-migration-password

# Password for the registration-only identity.
FINPATH_REGISTRATION_DB_PASSWORD=replace-with-a-long-random-registration-password

# Application database URLs used inside the Docker network. The host is the
# Compose service name `db`, never localhost.
FINPATH_DATABASE_URL=postgresql+psycopg://finpath_app:replace-with-a-long-random-runtime-password@db:5432/finpath
FINPATH_MIGRATION_DATABASE_URL=postgresql+psycopg://finpath_migrator:replace-with-a-long-random-migration-password@db:5432/finpath
FINPATH_REGISTRATION_DATABASE_URL=postgresql+psycopg://finpath_registration:replace-with-a-long-random-registration-password@db:5432/finpath

# Long random value used to sign access and CSRF tokens.
FINPATH_ACCESS_TOKEN_SECRET=replace-with-a-long-random-token-secret

# Local Docker development only. Keep verification enabled for any real
# deployment; the application refuses to disable it in production.
FINPATH_ENVIRONMENT=development
FINPATH_REQUIRE_EMAIL_VERIFICATION=false

# Keep true for Docker Compose so the backend runs migrations and the
# idempotent seed on startup. Deployment platforms that run migrations
# separately (for example Render) set this to false.
FINPATH_RUN_STARTUP_MIGRATIONS=true

# Browser origin used by the Nginx-served frontend.
FINPATH_FRONTEND_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Browser-side API base. This must be a host-reachable address, never the
# Docker service name `backend`. The backend publishes port 8000.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Host ports. The frontend proxies /api to the backend internally.
FINPATH_FRONTEND_PORT=8080
FINPATH_BACKEND_PORT=8000
