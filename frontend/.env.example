# Local development API base. The Vite dev server runs on
# http://localhost:5173 and the FastAPI server on http://localhost:8000.
#
# Cloudflare Pages builds must set VITE_API_BASE_URL=/api/v1 instead. The
# production default is already /api/v1, and a production bundle never falls
# back to localhost.
#
# Cloudflare Pages deployment tooling (Wrangler 4) requires Node.js 22+.
# Never put backend secrets in VITE_* variables; they are embedded in the
# browser bundle.
VITE_API_BASE_URL=http://localhost:8000/api/v1
