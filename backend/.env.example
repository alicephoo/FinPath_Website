FINPATH_APP_NAME="FinPath API"
FINPATH_ENVIRONMENT=development
# Run Alembic and the idempotent reference seed when the container starts.
# The default true preserves local Docker Compose. Set to false on Render and
# run migrations separately with FINPATH_MIGRATION_DATABASE_URL.
# FINPATH_RUN_STARTUP_MIGRATIONS=true
FINPATH_DATABASE_URL=postgresql+psycopg://<username>:<password>@127.0.0.1:5432/finpath
FINPATH_MIGRATION_DATABASE_URL=postgresql+psycopg://<migration_username>:<migration_password>@127.0.0.1:5432/finpath

# Dedicated registration identity. It may only insert the registration rows
# and assign role id 1 (user). Never give it runtime, migration, ownership, or
# Admin-assignment privileges. Provision it once as a PostgreSQL superuser;
# see backend/README.md. Use a unique strong random password.
FINPATH_REGISTRATION_DATABASE_URL=postgresql+psycopg://finpath_registration:<registration_password>@127.0.0.1:5432/finpath

# Access tokens are signed with this secret. Generate a long random value and
# never commit the real secret. The application fails closed without it.
FINPATH_ACCESS_TOKEN_SECRET=<long-random-secret>

# Optional authentication settings. The defaults match the approved design.
# FINPATH_ACCESS_TOKEN_ISSUER=finpath-api
# FINPATH_ACCESS_TOKEN_AUDIENCE=finpath-web
# FINPATH_ACCESS_TOKEN_TTL_SECONDS=900
# FINPATH_CSRF_TOKEN_AUDIENCE=finpath-csrf
# FINPATH_CSRF_TOKEN_TTL_SECONDS=900
# FINPATH_REFRESH_TOKEN_TTL_SECONDS=2592000
# FINPATH_REFRESH_INACTIVITY_TTL_SECONDS=604800
# Email verification is enforced by default. Local development may set this to
# false to create accounts as already verified and allow immediate login.
# Production remains fail-closed when verification is disabled unless the
# deployment explicitly sets FINPATH_ALLOW_UNVERIFIED_REGISTRATION=true for an
# MVP with no email provider. Do not disable verification for a real deployment
# that requires email ownership.
# FINPATH_REQUIRE_EMAIL_VERIFICATION=true
# FINPATH_ALLOW_UNVERIFIED_REGISTRATION=false
# FINPATH_EMAIL_VERIFICATION_TTL_SECONDS=86400
# FINPATH_PASSWORD_RESET_TTL_SECONDS=1800
# FINPATH_PASSWORD_MIN_LENGTH=12
# Maximum amount for one income/expense entry, in whole Kyat. This is an
# individual-entry limit, not an aggregate cap.
# FINPATH_MAX_FINANCIAL_ENTRY_KYAT=1000000000
# FINPATH_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# FINPATH_REFRESH_COOKIE_NAME=finpath_refresh
# FINPATH_REFRESH_COOKIE_PATH=/api/v1/auth
# Secure refresh-cookie default is environment-aware: false in development,
# local, test, or testing (so plain-HTTP localhost can persist the cookie), and
# true otherwise. Production rejects an explicit false at startup.
# FINPATH_REFRESH_COOKIE_SECURE=true

# Development email is written to an owner-only local outbox; no delivery is
# claimed. The outbox is development-only and is never selected in production.
# Production uses the Resend HTTPS API only when email verification is enabled.
# For the no-email MVP, leave the email backend unset: production resolves it to
# an unconfigured sender, no email is sent, and password-reset delivery is
# unavailable. Set FINPATH_RESEND_API_KEY only in the deployment platform;
# never commit the key.
# FINPATH_EMAIL_BACKEND=outbox
# FINPATH_EMAIL_OUTBOX_DIR=var/email_outbox
# FINPATH_EMAIL_BACKEND=resend
# FINPATH_RESEND_API_KEY=
# FINPATH_EMAIL_FROM=FinPath <no-reply@your-verified-domain.example>

# Dedicated PostgreSQL test database. Never point these at the development
# database. Provision it once as a PostgreSQL superuser:
#   CREATE DATABASE finpath_test OWNER finpath_migrator;
#   GRANT CONNECT ON DATABASE finpath_test TO finpath_app;
#   GRANT CONNECT ON DATABASE finpath_test TO finpath_registration;
FINPATH_TEST_DATABASE_URL=postgresql+psycopg://<username>:<password>@127.0.0.1:5432/finpath_test
FINPATH_TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://<migration_username>:<migration_password>@127.0.0.1:5432/finpath_test
FINPATH_TEST_REGISTRATION_DATABASE_URL=postgresql+psycopg://finpath_registration:<registration_password>@127.0.0.1:5432/finpath_test
